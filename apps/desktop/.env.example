# Copy to apps/desktop/.env for development builds. Never commit .env.
#
# Error reports (ADR 0013). With a DSN here, `pnpm dev` and local builds send
# errors and crashes to that Sentry project. A packaged build sends nothing
# until Settings → Privacy → "Send error reports" is on.
MAIN_VITE_SENTRY_DSN=

# "Continue with ChatGPT" (ADR 0006). Needs the client id OpenAI registers for
# Legible's sign-in. Without it, builds offer only an OpenAI API key.
MAIN_VITE_CHATGPT_CLIENT_ID=
